{
  "name": "thug2-content-pipeline",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "THUG2 content pipeline: the data overlay and menu builder, HD menu art, THUGPRO's THUG2 level changes and the THAW BMX tools; the level converters it installs are its dependencies. TypeScript run directly by Node 24.",
  "engines": {
    "node": ">=24"
  },
  "commands": [
    "editor_import/import_levels.ts",
    "hd_textures/compare_shots.ts",
    "hd_textures/compare_tex.ts",
    "hd_textures/fetch.ts",
    "hd_textures/globe/fetch.ts",
    "hd_textures/globe/fit.ts",
    "hd_textures/globe/redraw.ts",
    "hd_textures/ui.ts",
    "menu_level/art_picks.ts",
    "menu_level/frontend_art.ts",
    "menu_level/level_select_icons.ts",
    "menu_level/loading_art_games.ts",
    "menu_level/loading_select.ts",
    "menu_level/main_menu.ts",
    "menu_level/make_menu_level.ts",
    "menu_level/scenic_art.ts",
    "menu_level/scenic_capture.ts",
    "menu_level/scenic_spots.ts",
    "retail/retail_export.ts",
    "run.ts",
    "thaw_bmx/bike_scripts.ts",
    "thaw_bmx/convert.ts",
    "thaw_bmx/dump_scripts.ts",
    "thaw_bmx/survey.ts",
    "thug2_levels/thugpro_apply.ts",
    "thug2_levels/thugpro_compare.ts"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check --config-path=lint.biome.json .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#0c5e0d77a97debf79558e36d2ff118fd6c2affeb",
    "thug2-thugpro-compat": "git+https://git@github.com/CanuckAussieKev/thug2-thugpro-compat.git#76ca2893cd33e2586ce2752357fcd484c23abd5f",
    "thug2-thps2-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps2-level-converter.git#a2f8a382e74740d0287b88ea8573f3be5c24429a",
    "thug2-thps3-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps3-level-converter.git#093a9b99afd2dec3047fb48402ecb995daa1a6b4",
    "thug2-thps4-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps4-level-converter.git#211ab3b765e4e7993ba3eaeb603337f6fb0878e9",
    "thug2-thug1-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thug1-level-converter.git#2595092e76cb776a4132b5f0a7b4c4f576deec0b",
    "thug2-thaw-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thaw-level-converter.git#7e399b2343d1556166c8106d28dc43d14397bb5c",
    "thug2-thp8-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thp8-level-converter.git#1a1b150f93a8b4fea4214b0f6780d0092d4a2d2c",
    "thug2-thpg-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thpg-level-converter.git#0c8d8be7713874142236f24438db36aeb1d570ff"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}

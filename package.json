{
  "name": "thug2-content-pipeline",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "description": "THUG2 content pipeline: the data overlay and menu builder, HD menu art, THUGPRO's THUG2 level changes and the THAW BMX tools; the level converters it installs are its dependencies. TypeScript run directly by Node 24.",
  "engines": {
    "node": ">=24"
  },
  "commands": [
    "hd_textures/compare_shots.ts",
    "hd_textures/compare_tex.ts",
    "hd_textures/fetch.ts",
    "hd_textures/globe/fetch.ts",
    "hd_textures/globe/fit.ts",
    "hd_textures/globe/redraw.ts",
    "hd_textures/ui.ts",
    "menu_level/art_picks.ts",
    "menu_level/frontend_art.ts",
    "menu_level/level_select_icons.ts",
    "menu_level/loading_art_games.ts",
    "menu_level/loading_select.ts",
    "menu_level/main_menu.ts",
    "menu_level/make_menu_level.ts",
    "menu_level/scenic_art.ts",
    "menu_level/scenic_capture.ts",
    "menu_level/scenic_spots.ts",
    "run.ts",
    "thaw_bmx/bike_scripts.ts",
    "thaw_bmx/convert.ts",
    "thaw_bmx/dump_scripts.ts",
    "thaw_bmx/survey.ts",
    "thug2_levels/thugpro_apply.ts",
    "thug2_levels/thugpro_compare.ts"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check --config-path=lint.biome.json .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#f394e983eb339d3c782c7ced7b1bb8b3bbe43ef9",
    "thug2-thugpro-compat": "git+https://git@github.com/CanuckAussieKev/thug2-thugpro-compat.git#c31c9e69a56c1d4073bb2bad7d0f2844d59484bb",
    "thug2-thps2-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps2-level-converter.git#1a9c21bf01fe59c294e899956d34e5a496685611",
    "thug2-thps3-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps3-level-converter.git#20e2a1bb0c7d9959e08318dc9f6eb8161d25d17f",
    "thug2-thps4-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps4-level-converter.git#8b7f225a9ee0ed2c7048e4678d6430eb8219010f",
    "thug2-thug1-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thug1-level-converter.git#a2280938978e336f8ceecd32b25d9cf1ac921fc9",
    "thug2-thaw-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thaw-level-converter.git#bacb72c8d907d3fa449c92a8c84e7b6a2068859f",
    "thug2-thp8-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thp8-level-converter.git#a753deb9cbe57abe389f92c1968f2f1ca3c4090d",
    "thug2-thpg-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thpg-level-converter.git#49249161b397eb63a663c8f76f53fec315aea1f5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}

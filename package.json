{
  "name": "thug2-content-pipeline",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "THUG2 content pipeline: the data overlay and menu builder, HD menu art, THUGPRO's THUG2 level changes and the THAW BMX tools; the level converters it installs are its dependencies. TypeScript run directly by Node 24.",
  "engines": {
    "node": ">=24"
  },
  "commands": [
    "hd_textures/compare_shots.ts",
    "hd_textures/compare_tex.ts",
    "hd_textures/fetch.ts",
    "hd_textures/globe/fetch.ts",
    "hd_textures/globe/fit.ts",
    "hd_textures/globe/redraw.ts",
    "hd_textures/ui.ts",
    "menu_level/art_picks.ts",
    "menu_level/frontend_art.ts",
    "menu_level/level_select_icons.ts",
    "menu_level/loading_art_games.ts",
    "menu_level/loading_select.ts",
    "menu_level/main_menu.ts",
    "menu_level/make_menu_level.ts",
    "menu_level/scenic_art.ts",
    "menu_level/scenic_capture.ts",
    "menu_level/scenic_spots.ts",
    "run.ts",
    "thaw_bmx/bike_scripts.ts",
    "thaw_bmx/convert.ts",
    "thaw_bmx/dump_scripts.ts",
    "thaw_bmx/survey.ts",
    "thug2_levels/thugpro_apply.ts",
    "thug2_levels/thugpro_compare.ts"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check --config-path=lint.biome.json .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#1d172be89692cff3859b379937e842a9fdac4fd2",
    "thug2-thugpro-compat": "git+https://git@github.com/CanuckAussieKev/thug2-thugpro-compat.git#39f28fbfe236ffe6b93773fcd35bb9734c032198",
    "thug2-thps2-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps2-level-converter.git#9e783534be5ece9e25bfc19eeede56e742197d05",
    "thug2-thps3-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps3-level-converter.git#4f30b3e87341a5d4f6978598c3ee129dd2d0aa73",
    "thug2-thps4-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps4-level-converter.git#efef02a0b6f4e162152a10b8ba01f36fe841e57d",
    "thug2-thug1-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thug1-level-converter.git#38d4659ee7cf8907dc0442d495791a2a1488f017",
    "thug2-thaw-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thaw-level-converter.git#daf3efb39fc342a4a44d7b57ed728d68335bba56",
    "thug2-thp8-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thp8-level-converter.git#114631bfad55e4c2994b9d7a1405ea94b50d6940",
    "thug2-thpg-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thpg-level-converter.git#fc25613e943c91ec8439231d40d01ced525c62b2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}

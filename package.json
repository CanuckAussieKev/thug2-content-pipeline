{
  "name": "thug2-content-pipeline",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "THUG2 content pipeline: the data overlay and menu builder, HD menu art, THUGPRO's THUG2 level changes and the THAW BMX tools; the level converters it installs are its dependencies. TypeScript run directly by Node 24.",
  "engines": {
    "node": ">=24"
  },
  "commands": [
    "hd_textures/compare_shots.ts",
    "hd_textures/compare_tex.ts",
    "hd_textures/fetch.ts",
    "hd_textures/globe/fetch.ts",
    "hd_textures/globe/fit.ts",
    "hd_textures/globe/redraw.ts",
    "hd_textures/ui.ts",
    "menu_level/art_picks.ts",
    "menu_level/frontend_art.ts",
    "menu_level/level_select_icons.ts",
    "menu_level/loading_art_games.ts",
    "menu_level/loading_select.ts",
    "menu_level/main_menu.ts",
    "menu_level/make_menu_level.ts",
    "menu_level/scenic_art.ts",
    "menu_level/scenic_capture.ts",
    "menu_level/scenic_spots.ts",
    "run.ts",
    "thaw_bmx/bike_scripts.ts",
    "thaw_bmx/convert.ts",
    "thaw_bmx/dump_scripts.ts",
    "thaw_bmx/survey.ts",
    "thug2_levels/thugpro_apply.ts",
    "thug2_levels/thugpro_compare.ts"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check --config-path=lint.biome.json .",
    "test": "node --test \"**/*.test.ts\""
  },
  "dependencies": {
    "thug2-level-converter-core": "git+https://git@github.com/CanuckAussieKev/thug2-level-converter-core.git#96f3421f8bd4147ddda43c95af64c7201ba6c383",
    "thug2-thugpro-compat": "git+https://git@github.com/CanuckAussieKev/thug2-thugpro-compat.git#39651fa398dec289c96832454b4f97f30fa0c1df",
    "thug2-thps2-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps2-level-converter.git#015bb83e7b3ebf5b87ff347992f8ed95ef541960",
    "thug2-thps3-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps3-level-converter.git#25479ba4675c377eefd9a56084c11d67336b063a",
    "thug2-thps4-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thps4-level-converter.git#bc68221fd4bd9c0d874fa01bf762887af35629b3",
    "thug2-thug1-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thug1-level-converter.git#c85a56d228e77122e4d71905757593f88512e6eb",
    "thug2-thaw-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thaw-level-converter.git#49ce99f8ef30b2573e98e758a024bda59a6c4f23",
    "thug2-thp8-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thp8-level-converter.git#fff45334692e330005290e43b28dc19eaed052ca",
    "thug2-thpg-level-converter": "git+https://git@github.com/CanuckAussieKev/thug2-thpg-level-converter.git#5e1099c37e0d515a48f61eca750cc052f7ab504a"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}

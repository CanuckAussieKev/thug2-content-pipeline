    "thug2-thps2-level-converter": "github:CanuckAussieKev/thug2-thps2-level-converter#f58808706d33a4cdc74d8f8388f80f8e11ee1de2",
    "thug2-thps3-level-converter": "github:CanuckAussieKev/thug2-thps3-level-converter#e80e4bf98ac65426b799fb7177cc76abaa9f8f21",
    "thug2-thps4-level-converter": "github:CanuckAussieKev/thug2-thps4-level-converter#23f1def72842e9ca32b3bda1709e337a6bd6d144",
    "thug2-thug1-level-converter": "github:CanuckAussieKev/thug2-thug1-level-converter#2cf579acc5e50234d5d04642a76950c0f512beaa",

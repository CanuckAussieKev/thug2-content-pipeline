// (THAW's bike_skitch starts with Goto bike_OnGroundAi - its skitching was switched off there, and no bike exception
// table has Skitched; the user asked for skitching on R2: the rest of THAW's script, and Skitched in the on-ground
// table, Bike_OnGroundExceptionTable's - thaw_bmx_onground_exceptions)
//@unit bike_skitch
//@unit bike_SkitchOut
//@unit Bike_Bail_Cleanup
//@unit force_bike_bail
//@unit bike_bail
// (THAW's BailBoardControl and CreateBailBoard on the bike: a frame on, the ridden bike hidden and a rigid body one
// thrown in its place - at the rider's position and orientation with his velocity (THAW: spawned at his board bone, plus
// 100 along his facing - our rider's board bone isn't where the bike is); kill_bail_bike takes it away again)
script thaw_bmx_bail_bike_control {
    wait 1 gameframe
    if ObjectExists id=ThawBmx {
        ThawBmx:Hide
    }
    Obj_GetId
    MangleChecksums a=BailBike b=<objId>
    if ObjectExists id=<mangled_id> {
        <mangled_id>:Die
    }
    Obj_GetPosition
    Obj_GetQuat
    GetSkaterVelocity
    vel = (<vel_x> * (1.0, 0.0, 0.0) + <vel_y> * (0.0, 1.0, 0.0) + <vel_z> * (0.0, 0.0, 1.0))
    // (ours: a roll about the rider's facing, so the bike falls over at a standstill too - THAW's always has its push)
    Obj_GetOrientation
    rotvel = (<x> * (3.0, 0.0, 0.0) + <z> * (0.0, 0.0, 3.0))
    CreateCompositeObject Components=thaw_bmx_bail_bike_components Params={Name=<mangled_id> Pos=<Pos> Orientation=<Quat> NeverSuspend}
    if ObjectExists id=<mangled_id> {
        <mangled_id>:Obj_PlayAnim Anim=bmx_idle Speed=0 BlendPeriod=0
        // (the rigid body takes the object's orientation when made, before the composite's own is set: set it and
        // have the body read it again, then its velocities)
        <mangled_id>:Obj_SetOrientation quat=<Quat>
        <mangled_id>:RigidBody_Enable
        <mangled_id>:RigidBody_SetVelocities vel=<vel> rotvel=<rotvel>
        <mangled_id>:RigidBody_IgnoreSkater 15 frames
        <mangled_id>:RigidBody_Wake
    }
}

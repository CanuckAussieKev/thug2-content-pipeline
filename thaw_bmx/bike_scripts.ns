// THAW's Skater_Playanim: an animation tree branch on the rider and (Skater_Anim_Command) the bike - here PlayAnim
// on the rider, Obj_PlayAnim on the bike when it has the animation (they pair by name).
script thaw_bmx_playanim {
    if GotParam NoRestart {
        if AnimEquals <anim> {
            return
        }
    }
    PlayAnim <...>
    if ObjectExists id=ThawBmx {
        if ThawBmx:AnimExists <anim> {
            ThawBmx:Obj_PlayAnim <...>
        }
    }
}
script thaw_bmx_waitanim {
    Obj_WaitAnimFinished
}
// THAW's Skater_PlayBarspinAnim / Skater_BarspinAnimOff: a partial branch (BarspinSwitch) on the rider and the bike -
// here the anim subset Barspin on both.
script thaw_bmx_playbarspin {
    if ! Obj_AnimSubsetExists SubsetId=Barspin {
        Obj_AddAnimSubset SubsetId=Barspin Stage=3
        Obj_SetAnimSubsetWeight SubsetId=Barspin BlendWeight=1
    }
    PlayAnim SubsetId=Barspin <...>
    if ObjectExists id=ThawBmx {
        if ThawBmx:AnimExists <anim> {
            if ! ThawBmx:Obj_AnimSubsetExists SubsetId=Barspin {
                ThawBmx:Obj_AddAnimSubset SubsetId=Barspin Stage=3
                ThawBmx:Obj_SetAnimSubsetWeight SubsetId=Barspin BlendWeight=1
            }
            ThawBmx:Obj_PlayAnim SubsetId=Barspin <...>
        }
    }
}
script thaw_bmx_waitbarspin {
    Obj_WaitAnimFinished SubsetId=Barspin
}

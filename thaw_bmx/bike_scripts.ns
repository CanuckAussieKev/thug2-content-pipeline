//@unit bike_manual
//@unit SetBikeTrickName
//@unit create_bike_manual_meter
//@unit destroy_bike_manual_meter
//@unit bike_manual_state
//@unit bike_nosemanual_state
// (bike_manual_state's and bike_nosemanual_state's own loop body: the pad shakes with the manual angle)
script thaw_bmx_manual_vibration {
    GetBikeManualAngle
    if InTireTap {
        manual_angle = (<manual_angle> - 50)
        if (<manual_angle> < 0) {
            manual_angle = (-4 * <manual_angle>)
        } else {
            manual_angle = (4 * <manual_angle>)
        }
    }
    if (<manual_angle> < 0) {
        manual_angle = (-1 * <manual_angle>)
    }
    if (<manual_angle> > 99) {
        manual_angle = 99
    }
    Vibrate Actuator=1 Percent=<manual_angle>
}
//@unit bike_manual_pivot
//@unit bike_exit_endo
//@unit bike_backwards_balance_trick
//@unit bike_backwards_revert
// (ours, the user's request: the manuals on THUG2's input as well - up then down a manual, down then up a nose manual,
// THUG2's ManualTricks / GroundManualTricks timings; in the air the press is kept for the landing (bike_land2), so
// manuals link into combos as the skater's do. THAW's own way - the stick held back / forward half a second, the
// physics' manual pitch - stays.)
thaw_bmx_AirManualTricks = [
    {Trigger={InOrder, Up, Down, 400} Duration=700 Scr=thaw_bmx_manual}
    {Trigger={InOrder, Down, Up, 400} Duration=700 Scr=thaw_bmx_manual Params={nose}}
]
thaw_bmx_GroundManualTricks = [
    {Trigger={InOrder, Up, Down, 220} Scr=thaw_bmx_manual}
    {Trigger={InOrder, Down, Up, 220} Scr=thaw_bmx_manual Params={nose}}
]
script thaw_bmx_manual {
    if GotParam nose {
        EnterWheelieFromAir nose
        Goto bike_manual params={nose}
    } else {
        EnterWheelieFromAir
        Goto bike_manual
    }
}
// (ours, the user's request: THUG2's revert on the bike - R2 / L2 as it lands from vert (bike_land2 opens the window,
// THUG2's Reverts triggers), a pivot round with THAW's bmx_pivot_frombackwards as its bike_backwards_revert plays it;
// THUG2's revert's name and score, the combo going on - a manual can follow, as the skater's revert)
thaw_bmx_Reverts = [
    {Trigger={Press, R2, 200} Scr=bike_revert}
    {Trigger={Press, L2, 200} Scr=bike_revert}
]
script bike_revert {
    KillExtraTricks
    StopBalanceTrick
    OnExitRun bike_exit_revert
    InRevert
    ResetLandedFromVert
    ClearException Ollied
    LaunchStateChangeEvent State=Skater_InRevert
    SetQueueTricks NoTricks
    SetManualTricks thaw_bmx_AirManualTricks
    if LastSpinWas Frontside {
        SetTrickName %"FS Revert"
    } else {
        SetTrickName %"BS Revert"
    }
    SetTrickScore 100
    Display Blockspin
    Vibrate Actuator=1 Percent=80 duration=0.1
    Rotate
    if LastSpinWas Frontside {
        Flip
    }
    Skater_PlayBikeAnim anim=bmx_pivot_frombackwards BlendPeriod=0
    if LastSpinWas Frontside {
        FlipAfter
    }
    SetException Ex=Ollied Scr=BIKE_OLLIE
    while {
        if AnimFinished {
            break
        }
        wait 1 gameframe
    }
    Goto bike_land2 params={no_anim}
}
script bike_exit_revert {
    OutRevert
}
